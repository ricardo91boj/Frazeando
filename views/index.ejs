<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Frazeado</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>

    <!-- Navbar -->
    <header class="header">
        <nav class="navbar">

            <!-- Logo -->
            <a href="#">
                <img src="images/logo-frazeando.png" alt="Frazeando - Aprende español">
            </a>

            <!-- Nav Menu -->
            <ul>
                <li><a href="#about" class="navbar__link">About</a></li>
                <li><a href="#programs" class="navbar__link">Programs</a></li>
                <li><a href="#contact" class="navbar__link">Contact</a></li>
            </ul>

        </nav>
    </header>

    <!-- ABOUT  -->
    <!-- First section  -->
    <section class="first-sec">
        <div class="hero-ctn">

            <!-- Hero Card -->
            <div class="hero-card">
                <h1>Learn Spanish, one phrase at a time</h1>
                <p>
                    Real conversations, practical phrases and classes designed
                    to get you speaking Spanish from day one.
                </p>
                <button>Start learning</button>
            </div>

            <!-- Hero image -->
            <div class="hero-image">
                <img src="/images/hero.jpg" alt="Student learning Spanish online">
            </div>
        </div>
    </section>

    <!-- Second section  -->
    <section class="second-sec">
        <div class="second-ctn">

            <!-- Left Card -->
            <div class="left-card">
                <h2>Why Frazeando?</h2>
            </div>

            <!-- Right Card -->
            <div class="right-card">
                <p>
                    At Frazeando we believe a language is learned through phrases,
                    not lists of isolated words.
                </p>
                <p>
                    Our classes focus on real situations: ordering food, making
                    friends, travelling and working in Spanish.
                </p>
                <p>
                    Small groups and personal attention help you gain confidence
                    and start speaking from your very first lesson.
                </p>
            </div>

        </div>
    </section>

    <!-- Third Section  -->
    <section class="third-sec">
        <div class="third-ctn">

            <!-- Image -->
            <img src="/images/cta.jpg" alt="Spanish class in progress">

            <!-- Text -->
            <p>
                From your first words to fluent conversations: discover our
                group and private courses for every level.
            </p>

            <!-- Call to action button -->
            <button>Get started</button>

        </div>
    </section>

    <!-- Forth section  -->
    <section class="forth-sec">
        <div class="forth-ctn">

            <!-- First Card  -->
            <div class="features__card first-card">
                <div>
                    <h2>Learn by speaking</h2>
                    <img src="/images/feature-1.jpg" alt="Students talking in Spanish">
                </div>
                <p>
                    Every lesson is built around real conversations, so you practise
                    speaking from the very first day.
                </p>
            </div>

            <!-- Second Card -->
            <div class="features__card second-card">
                <h2>Learn at your pace</h2>
                <p>
                    Online classes that fit your schedule, with materials you can
                    review anytime.
                </p>
                <img src="/images/feature-2.jpg" alt="Online Spanish lesson">
            </div>
        </div>

        <!-- Button below both cards -->
        <butto>Join a class
        </butto>
    </section>
</body>

</html>