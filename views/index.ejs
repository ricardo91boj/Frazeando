<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Frazeado</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>

    <!-- Navbar -->
    <header class="header">
        <nav class="navbar">

            <!-- Logo -->
            <a href="#">
                <img src="images/logo-frazeando.png" alt="Frazeando - Aprende español">
            </a>

            <!-- Nav Menu -->
            <ul>
                <li><a href="#about" class="navbar__link">About</a></li>
                <li><a href="#programs" class="navbar__link">Programs</a></li>
                <li><a href="#contact" class="navbar__link">Contact</a></li>
            </ul>

        </nav>
    </header>

    <!-- ABOUT  -->
    <!-- First section  -->
    <section class="first-sec">
        <div class="hero-ctn">

            <!-- Hero Card -->
            <div class="hero-card">
                <h1>Speak real Spanish and
                    feel at home in Latin
                    America</h1>
                <p>
                    Dynamic, natural conversation
                    classes for professionals and retirees
                    ready for true local integration.
                </p>
                <button>Book your Diagnostic Session</button>
            </div>

            <!-- Hero image -->
            <div class="hero-image">
                <img src="/images/hero.jpg" alt="Student learning Spanish online">
            </div>
        </div>
    </section>

    <!-- Second section  -->
    <section class="second-sec">
        <div class="second-ctn">

            <!-- Left Card -->
            <div class="left-card">
                <h2>Does this sound like you?</h2>
            </div>

            <!-- Right Card -->
            <div class="right-card">
                <p>
                    Know some words, but fear is holding you
                    back from speaking?
                </p>
                <p>
                    Stuck in a "tourist bubble" and struggling
                    to connect with locals?
                </p>
                <p>
                    Tired of dry grammar drills that don't
                    help in real life?
                </p>
            </div>

        </div>
    </section>

    <!-- Third Section  -->
    <section class="third-sec">
        <div class="third-ctn">

            <!-- Image -->
            <img src="/images/cta.jpg" alt="Spanish class in progress">

            <!-- Text -->
            <p>
                You don't need perfect grammar to speak with confidence. With the Frazeando method, you'll turn isolated
                words into
                fluent conversations through structured practice and ultra-small groups—starting your very first week.
            </p>

            <!-- Call to action button -->
            <button>Book your Diagnostic Session</button>

        </div>
    </section>

    <!-- Forth section  -->
    <section class="forth-sec">
        <div class="forth-ctn">

            <!-- First Card  -->
            <div class="features-card first-card">
                <div>
                    <h2>The Idea Behind
                        Frazeando:</h2>
                    <img src="/images/feature-1.jpg" alt="Students talking in Spanish">
                </div>
                <p>
                    I didn't want to offer just another
                    language course. I developed
                    Frazeando by fine-tuning
                    conversational techniques over years
                    of real classroom experience, adapting
                    them so you can speak naturally from
                    day one.
                </p>
            </div>

            <!-- Second Card -->
            <div class="features-card second-card">
                <h2>Why Learn With Me:</h2>
                <p>
                    My goal is simple: to give you the
                    confidence and natural phrasing
                    you need to break out of the
                    "tourist bubble" and truly feel at
                    home in Latin America.

                    Connect, don't just conjugate!
                </p>
                <img src="/images/feature-2.jpg" alt="Online Spanish lesson">
            </div>
        </div>

        <!-- Button below both cards -->
        <button>Book your Diagnostic Session
            Idea line art
        </button>
    </section>

    <!-- PROGRAMS  -->
    <!-- Fifth section  -->
    <section class="fifth-section">

        <!-- Title -->
        <div>
            <h1>Programs</h1>
        </div>

        <!-- Main container -->
        <div class="fifth-ctn">

            <!-- What's included title -->
            <h2>What’s Included in Every Program:</h2>

            <!-- First subdiv -->
            <div class="program-card">
                <p>Ultra-Focused Sessions (55 min): Dynamic
                    conversation practice where every minute
                    counts.</p>
                <p>Continuous WhatsApp Support: Questions
                    between classes? Send a quick text or voice
                    note for local guidance.</p>
            </div>

            <!-- Second subdiv -->
            <div class="program-card">
                <p>The Frazeando + Mirror Method: Build full
                    sentences naturally and speak without
                    translating in your head.</p>
                <p>7-Day Session Recordings: Replay your classes
                    anytime for 7 days to reinforce learning.</p>
            </div>

            <!-- Third subdiv -->
            <div class="program-card">
                <p>Custom Post-Class Notes: Live study notes
                    with your vocabulary and feedback — no
                    extra homework needed!</p>
                <button type="button">Book your Diagnostic Session</button>
            </div>

        </div>

    </section>

    <!-- Second Section  -->

    <div class="sixth-ctn">

        <!-- Title -->
        <div class="h1-div">
            <h1>Choose Your Path
                to Integration</h1>
        </div>

        <!-- First Cards container -->
        <div class="programs-ctn">
            <div class="cards-ctn">

                <!-- Card 1 -->
                <div class="card">
                    <h2>Beginners 1</h2>
                    <p>From “Hola, buenos días” to
                        “Vivo en Portales, cerca de
                        la universidad.”</p>
                    <img src="" alt="card image">
                    <p>Duration: 12 Weeks
                        (36 Classes | 3 classes per week)</p>
                    <hr>
                    <p>Best for:
                        Best for absolute beginners
                        starting from zero, or learners
                        with scattered vocabulary who
                        want to build a solid foundation.</p>
                    <hr>
                    <p>1-on-1 Private:
                        3 monthly payments of $360 USD
                        (or $999 USD single payment)*</p>
                    <hr>
                    <p>Small Group (Max 2-3 students):
                        3 monthly payments of $240 USD
                        (or $649 USD single payment) /
                        per person*</p>
                    <!-- content coming -->
                </div>

                <!-- Card 2 -->
                <div class="card">
                    <h2>Beginners 2</h2>
                    <p>The future, the past, and
                        the ability to be more
                        specific in our lives.</p>
                    <img src="" alt="card image">
                    <p>Duration: 12 Weeks
                        (36 Classes | 3 classes per week)</p>
                    <hr>
                    <p>Best for:
                        Best for learners who know basic
                        phrases and present tense, but
                        struggle to talk about the past,
                        future, or express specific ideas.</p>
                    <hr>
                    <p>1-on-1 Private:
                        3 monthly payments of $360 USD
                        (or $999 USD single payment)*</p>
                    <hr>
                    <p>Small Group (Max 2-3 students):
                        3 monthly payments of $240 USD (or $649 USD single payment) / per person*</p>
                    <!-- content coming -->
                </div>

                <!-- Card 3 -->
                <div class="card">
                    <h2>Intermediate 1</h2>
                    <p>From simple past to storytelling...
                        and navigating hypothetical love,
                        because for every 'I would',
                        there's always a 'but'.</p>
                    <img src="" alt="card image">
                    <p>Duration: 6 Weeks
                        (18 Classes | 3 classes per week)</p>
                    <hr>
                    <p>Best for:

                        Best for conversational speakers who want to stop sounding robotic, express complex thoughts,
                        and handle real-life
                        scenarios smoothly.</p>
                    <hr>
                    <p>1-on-1 Private:

                        2 installments of $270 USD (or
                        $499 USD single payment)*</p>
                    <hr>
                    <p>Small Group (Max 2–3 students):

                        2 installments of $180 USD (or
                        $329 USD single payment) / per
                        person*</p>
                    <!-- content coming -->
                </div>

            </div>
            <!-- Bottom elements -->
            <p>*Prices are final</p>
            <button type="button">Book your Diagnostic Session</button>
        </div>

        <!-- Second Cards Container  -->
        <div class="programs-ctn">
            <div class="cards-ctn">

                <!-- Card 1 -->
                <div class="card">
                    <h2>Intermediate 2</h2>
                    <p>Let’s W-E-I-R-D-O!
                        Diving into the Subjunctive.
                    </p>
                    <img src="" alt="card image">
                    <p>First point</p>
                    <hr>
                    <p>Best for:

                        Upper-intermediate learners ready
                        to master the subjunctive mode—
                        expressing doubts, wishes, and
                        emotions with confidence and zero
                        overwhelm.</p>
                    <hr>
                    <p>1-on-1 Private:

                        2 installments of $270 USD (or
                        $499 USD single payment)*</p>
                    <hr>
                    <p>Small Group (Max 2–3 students):

                        2 installments of $180 USD (or $329 USD single payment) / per person*</p>
                    <!-- content coming -->
                </div>

                <!-- Card 2 -->
                <div class="card">
                    <h2>Keep the Spark

                        Alive</h2>
                    <p>Maintenance & Practice</p>
                    <img src="" alt="card image">
                    <p>Duration: 4-week pass

                        (1 session per week)</p>
                    <hr>
                    <p>Best for:

                        Program graduates or advanced
                        learners looking to stay sharp with
                        100% customized weekly sessions.</p>
                    <hr>
                    <p>Format: 100% 1-on-1 Private

                        Real-world topics & current
                        events

                        Ongoing feedback &
                        vocabulary expansion</p>
                    <hr>
                    <p>Investment:

                        $114 USD / every 4 weeks.*</p>
                    <!-- content coming -->
                </div>

                <!-- Card 3 -->
                <div class="card">
                    <h2>Sound it right</h2>
                    <p>Pronunciation & Accent Training</p>
                    <img src="" alt="card image">
                    <p>Quick Fine-Tuning:

                        7 Classes

                        Ideal if you just need to polish
                        specific sounds and refine your
                        overall clarity.

                        $229 USD single payment*</p>
                    <hr>
                    <p>Deep Fix:

                        14 Classes

                        Recommended if you struggle with specific native sounds and need hands-on repetition to reshape
                        your mouth muscle
                        memory.

                        $399 USD single payment*</p>
                    <hr>
                    <p>Format: 100% 1-on-1 Private</p>
                    <hr>
                    <p>Pay-As-You-Go:

                        $40 USD / single session*</p>
                    <!-- content coming -->
                </div>

            </div>

            <!-- Bottom elements -->
            <p>*Prices are final</p>
            <button type="button">Book your Diagnostic Session</button>
        </div>

    </div>

    <!-- Seventh Section  -->
    <div class="guarantee-ctn">
        <h2>Risk-Free Guarantee:</h2>
        <p>12-Week Programs: If you realize the program isn't for you within the first 4 weeks,
            you'll receive a 100% refund for the remaining 8 weeks.</p>
        <p>6-Week Programs: If you realize the program isn't for you within the first 3 weeks, you'll
            receive a 100% refund for the remaining 3 weeks.</p>
    </div>

    <!-- Eight Section  -->
    <!-- Contact section -->
    <div class="eight-ctn">

        <!-- Title -->
        <h1>Contact me!</h1>

        <!-- Main subdiv -->
        <div class="contact-main">

            <!-- First div: CTA -->
            <div class="contact-cta">
                <h2>Ready to meet?</h2>
                <button type="button">Book your Diagnostic Session</button>
            </div>

            <!-- Second div: social media -->
            <div class="contact-social">
                <h3>info@frazeando.com</h3>

                <!-- Icons subdiv -->
                <div class="social-icons">
                    <img src="" alt="icon 1">
                    <img src="" alt="icon 2">
                    <img src="" alt="icon 3">
                    <img src="" alt="icon 4">
                </div>

            </div>

        </div>

    </div>

    <!-- Nineth Section  -->
    <!-- Diagnostic Lection -->
    <section class="diagnostic-sec">

        <!-- Div 1: session info and booking button -->
        <div class="diagnostic-info">
            <h2>Diagnostic Session
            
            (30–45 min)</h2>
            <h3>Thinking about booking your first call?</h3>
            <p>
                No tests, no pressure—just a relaxed
                chat to get to know each other,
                discuss your goals, and see if we're a
                great fit.
            </p>
            <a href="#">Book your Diagnostic Session</a>
        </div>

        <!-- Div 2: what to expect -->
        <div class="diagnostic-expect">
            <h2>What to expect:</h2>

            <!-- Item 1 -->
            <div class="diagnostic-item">
                <img src="/images/icon-chat.svg" alt="">
                <p>Absolute Beginners: We’ll map out
                your goals and walk you through the
                Beginner 1 roadmap step-by-step.</p>
            </div>

            <!-- Item 2 -->
            <div class="diagnostic__item">
                <img src="/images/icon-target.svg" alt="">
                <p>Intermediate & Advanced: We’ll
                assess your current level and tailor a
                custom blend of courses for your
                needs.</p>
            </div>

            <!-- Item 3 -->
            <div class="diagnostic__item">
                <img src="/images/icon-plan.svg" alt="">
                <p>Mini-Lesson Experience: Get a
                hands-on taste of my teaching style
                in action.</p>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer">
        <div class="footer__container">

            <!-- Div 1: copyright text -->
            <div class="footer__info">
                <p class="footer__text">© 2026 Frazeando. All rights reserved.</p>
            </div>

            <!-- Div 2: logo -->
            <div class="footer__logo">
                <img src="/images/logo-frazeando.png" alt="Frazeando logo">
            </div>

        </div>
    </footer>
</body>

</html>