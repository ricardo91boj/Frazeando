    <!-- Nineth Section  -->
    <!-- Diagnostic Lection -->
    <section class="diagnostic-sec">
    
        <!-- Div 1: session info and booking button -->
        <div class="diagnostic-info">
            <h2>Diagnostic session</h2>
            <h3>Thinking about booking?</h3>
            <p>
                No test, no pressure. Just a relaxed conversation to find out
                where you are and where you want to go.
            </p>
            <a href="#">Book</a>
        </div>
    
        <!-- Div 2: what to expect -->
        <div class="diagnostic-expect">
            <h2>What to expect</h2>
    
            <!-- Item 1 -->
            <div class="diagnostic-item">
                <img src="/images/icon-chat.svg" alt="">
                <p>A short conversation in Spanish at your level.</p>
            </div>
    
            <!-- Item 2 -->
            <div class="diagnostic__item">
                <img src="/images/icon-target.svg" alt="">
                <p>We talk about your goals and why you want to learn.</p>
            </div>
    
            <!-- Item 3 -->
            <div class="diagnostic__item">
                <img src="/images/icon-plan.svg" alt="">
                <p>You get a recommendation for the right program.</p>
            </div>
        </div>
